# ---- Core ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/writearena
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-freshly-generated-secret-never-commit-the-real-one
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Seeded admin account (verified automatically) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@writearena.com
# Pick a real password before first run — this is only a placeholder.
ADMIN_PASSWORD=change-this-before-first-run

# ---- NLP ----
# Public pretrained detector by default. Point this at your own fine-tuned
# model's Hub ID (see ml/WriteArena_AI_Detector_Training.ipynb) to use that
# instead — the docs should describe whichever one is actually set here.
HF_MODEL=Hello-SimpleAI/chatgpt-detector-roberta
ENV=development

# ---- Google Sign-In (OAuth) ----
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client
# ID (type "Web application"). Add your frontend origin(s) under "Authorized
# JavaScript origins". This value must match VITE_GOOGLE_CLIENT_ID in
# frontend/.env exactly. Leave blank to disable the Google button entirely.
GOOGLE_CLIENT_ID=

# ---- Email (OTP verification & password reset) ----
# Option 1 — Resend (simplest): sign up at resend.com, paste the API key.
RESEND_API_KEY=
# Option 2 — SMTP (Gmail example: smtp.gmail.com / 587 / STARTTLS / app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
EMAIL_FROM=WriteArena <no-reply@writearena.com>
OTP_TTL_SECONDS=600

# Public HTTPS URL of this deployment. Required for live payment provider
# return/callback URLs (JazzCash/EasyPaisa redirect + postback here). Not
# used in sandbox mode.
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Pricing (PKR) ----
PRICE_COACH=500
PRICE_CERTIFICATE=100
PRICE_STREAK_FREEZE=300
PRICE_TOURNAMENT_ENTRY=150
USD_RATE=280
CERT_MIN_SCORE=95
CERT_MIN_STREAK=7

# ---- Payments (JazzCash / EasyPaisa / NayaPay) ----
# "sandbox" auto-completes payments (demo, no credentials needed).
# "live" builds and sends real requests to whichever provider(s) below have
# credentials filled in — requires a real merchant account with that
# provider PLUS a real HTTPS PUBLIC_BASE_URL (see payment_service.py's
# module docstring for the exact protocol each one implements).
PAYMENTS_MODE=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
NAYAPAY_CLIENT_ID=
NAYAPAY_API_KEY=

# ---- AI writing coach ----
# Online: OpenAI-compatible API (blank key = skip to next tier).
# Offline: Ollama running locally/on your server.
# Neither configured = falls back to a fixed heuristic tip, NOT a real model —
# make sure at least one of these is set before calling this feature "AI".
COACH_API_BASE=https://api.openai.com/v1
COACH_API_KEY=
COACH_MODEL=gpt-4o-mini
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
